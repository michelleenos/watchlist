{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "node",
        "lib": ["ES2022"],
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,

        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,

        "noImplicitAny": true
        // "noUnusedLocals": true,
        // "noUnusedParameters": true
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
